# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lead:leadpass@localhost:5432/leadengine

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...  # Used for embeddings (text-embedding-3-small) + Whisper only

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=leadengine_verify_2026
# Meta App Secret — verifies X-Hub-Signature-256 on inbound webhooks.
# REQUIRED in production (find it in Meta App Dashboard → Settings → Basic).
META_APP_SECRET=

# Sentry error tracking (optional — leave empty to disable)
SENTRY_DSN=
# Note: per-client waba_token and waba_phone_number_id are stored in client_config table

# ── Langfuse Observability ────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3001

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production_32chars_min

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # Comma-separated allowed origins

# ── Webhook Processing ───────────────────────────────────────────────────────
WEBHOOK_MODE=async  # "async" (default, uses Redis worker) or "sync" (dev only)

# ── Whisper STT (voice note transcription) ────────────────────────────────
WHISPER_URL=http://localhost:9000   # docker-whisper OpenAI-compatible API

# ── LiveKit (voice agent + outbound calls) ────────────────────────────────
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ── SIP Trunk (configure for your provider: Twilio, Exotel, etc.) ────────
SIP_TRUNK_ID=                       # Created via LiveKit SIP API
SIP_TRUNK_OUTBOUND_URI=             # e.g., sip:+911234567890@sip.exotel.com
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=

# ── Voice Agent ───────────────────────────────────────────────────────────
VOICE_AGENT_CALLER_ID=              # Your DID number for outbound calls
VOICE_FOLLOWUP_DELAY_HOURS=4        # Hours before auto-calling unresponsive leads

# ── Google Calendar (optional per client, stored in client_config) ─────────────
# GOOGLE_SERVICE_ACCOUNT_JSON=...
